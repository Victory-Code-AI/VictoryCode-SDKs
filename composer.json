{
    "name": "victorycode/sdk",
    "description": "Client APIs for Tactix partners: authenticate, upload game video, and retrieve games, plays, game recaps and team metadata.",
    "keywords": [
        "openapitools",
        "openapi-generator",
        "openapi",
        "php",
        "sdk",
        "rest",
        "api"
    ],
    "homepage": "https://github.com/victory-code-ai/victorycode-sdks",
    "license": "MIT",
    "authors": [
        {
            "name": "Victory Code",
            "homepage": "https://github.com/victory-code-ai/victorycode-sdks"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.3",
        "guzzlehttp/psr7": "^1.7 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.0 || ^9.0",
        "friendsofphp/php-cs-fixer": "^3.5"
    },
    "autoload": {
        "psr-4": {
            "VictoryCode\\SDK\\": "php/lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "VictoryCode\\SDK\\Test\\": "php/test/"
        }
    }
}
